{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mistbean-coffee",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "mistbean-db", "database_id": "REPLACE_AFTER_CREATE" }],
  "r2_buckets": [{ "binding": "INVOICES", "bucket_name": "mistbean-invoices" }],
  "vars": {
    "BUSINESS_NAME": "MistBean Coffee",
    "BUSINESS_CITY": "Coorg, Karnataka",
    "WHATSAPP_MODE": "mock",
    "CURRENCY": "INR",
    "WHATSAPP_PHONE_NUMBER_ID": "",
    "WHATSAPP_TEMPLATE_ORDER_RECEIVED": "mistbean_order_received",
    "WHATSAPP_TEMPLATE_ORDER_UPDATE": "mistbean_order_update",
    "WHATSAPP_TEMPLATE_INVOICE": "mistbean_invoice",
    "SELLER_LEGAL_NAME": "MistBean Coffee",
    "SELLER_ADDRESS": "Update before launch",
    "SELLER_GSTIN": "",
    "FSSAI_LICENSE_NUMBER": "",
    "UPI_ID": "",
    "UPI_PAYEE_NAME": "MistBean Coffee"
  }
}
